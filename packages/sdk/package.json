{
  "name": "@seam/sdk",
  "version": "0.1.0",
  "description": "SEAM SDK and CLI: Manifest helpers, execution receipts, plain-English explanations, and the end-to-end flow over compiler, policy and chain",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "seam": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "@seam/compiler": "file:../compiler",
    "@seam/policy": "file:../policy",
    "@polkadot/util-crypto": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "esbuild": "^0.21.5"
  }
}
