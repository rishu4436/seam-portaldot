{
  "name": "@seam/chain",
  "version": "0.1.0",
  "description": "SEAM chain layer for Portaldot: live discovery, runtime recheck, preflight, signing handoff, submit and track",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "SEAM_LIVE=1 vitest run tests/live.test.ts"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@polkadot/rpc-provider": "^17.0.2",
    "@polkadot/types": "^17.0.2",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@seam/compiler": "file:../compiler"
  },
  "devDependencies": {
    "@polkadot/keyring": "^14.0.3",
    "@seam/policy": "file:../policy",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
