{
  "name": "seam",
  "private": true,
  "description": "SEAM: one intent, multiple execution surfaces, one verified result, for Portaldot",
  "workspaces": [
    "packages/compiler",
    "packages/policy",
    "packages/sdk",
    "packages/chain",
    "packages/console"
  ],
  "scripts": {
    "build": "npm run build -w @seam/compiler && npm run build -w @seam/policy && npm run build -w @seam/chain && npm run build -w @seam/sdk && npm run build -w @seam/console",
    "test": "npm test -w @seam/compiler && npm test -w @seam/policy && npm test -w @seam/sdk && npm test -w @seam/chain && npm test -w @seam/console",
    "test:control-plane": "node --test services/control-plane/test/*.test.mjs",
    "smoke:pack": "bash scripts/pack-smoke.sh",
    "test:e2e": "bash tests/e2e/run.sh",
    "seam": "node packages/sdk/dist/cli.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write packages services/control-plane eslint.config.mjs",
    "format:check": "prettier --check packages services/control-plane eslint.config.mjs .prettierrc.json",
    "example:consumer": "node examples/consumer/index.mjs",
    "examples:templates": "node examples/templates/index.mjs",
    "evidence:manifest": "node scripts/evidence-manifest.mjs",
    "docs:quickstart-check": "node scripts/quickstart-check.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
